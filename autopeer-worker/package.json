{
  "name": "autopeer-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "rm -rf public && cd ../autopeer && env -u NO_COLOR trunk build --release --dist ../autopeer-worker/public",
    "dev": "wrangler dev",
    "deploy": "npm run build:site && wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^6.1.2",
    "openpgp": "^6.3.0",
    "sshsig": "^0.3.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.8",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.44.0"
  }
}
