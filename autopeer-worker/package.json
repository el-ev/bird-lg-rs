{
  "name": "autopeer-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "rm -rf public && cd ../autopeer && env -u NO_COLOR trunk build --release --dist ../autopeer-worker/public",
    "dev": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "deploy:lax-01": "cd \"${NODES_REPO:-../../../network/nodes}\" && ansible-playbook playbooks/websites.yaml --tags autopeer-frontend --limit 'lax-01,localhost'",
    "deploy": "npm run build:site && npm run deploy:worker && npm run deploy:lax-01",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dn42-auth-worker": "file:../dn42-auth-worker",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.8",
    "@types/node": "^24.6.0",
    "openpgp": "^6.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.44.0"
  }
}
