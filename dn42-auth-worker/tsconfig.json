{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "composite": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"]
}
